#include <iostream>
using namespace std;

int main() {
    int penjualan[5] = {20, 35, 25, 40, 30};
    int total = 0;
    
    cout << "Penjualan: " << endl;
    for (int i = 0; i < 5; i++) {
        cout << "Hari " << (i + 1) << " = " << penjualan[i] << endl;
        total += penjualan[i];
    }
    
    float rata_rata = static_cast<float>(total) / 5;
    
    cout << endl;
    cout << "Total penjualan = " << total << endl;
    cout << "Rata-rata penjualan = " << rata_rata << endl;

    return 0;
}
