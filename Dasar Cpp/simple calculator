#include <iostream> 
using namespace std;

int main() {
  int angka1, angka2, hasil;
  char operasi; 
  
  cout << "Masukkan angka pertama: ";
  cin >> angka1;
  
  cout << "Masukkan angka kedua: ";
  cin >> angka2;
  
  cout << "Masukkan operasi (+, -, *, /): ";
  cin >> operasi;
  
  if (operasi == '+') {
    hasil = angka1 + angka2;
    cout << "Hasil: "<< hasil << endl;
  } else if (operasi == '-') {
    hasil = angka1 - angka2;
    cout << "Hasil: " << hasil << endl;
  } else if (operasi == '*') {
    hasil = angka1 * angka2;
    cout << "Hasil: " << hasil << endl;
  } else if (operasi == '/'){
    if (angka2 !=0) {
      hasil = angka1 / angka2;
      cout << "Hasil: " << hasil << endl;
    } else { 
    cout << "Error: Pembagian dengan nol tidak diperbolehkan." << endl;
    }
  } else { 
  cout << "Operasi tidak valid." << endl;
  }
 return 0;
}
